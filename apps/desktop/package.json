{
  "name": "meeting-stt",
  "productName": "meeting-stt-team",
  "version": "0.2.5",
  "description": "서버 없이 로컬에서 동작하는 STT 회의록 데스크탑 앱 (whisper.cpp + sherpa-onnx)",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:mac:release": "pnpm run build && electron-builder --mac -c.mac.notarize=true",
    "release:mac": "pnpm run build && electron-builder --mac -c.mac.notarize=true --publish always",
    "setup:bin": "tsx scripts/setupBin.ts",
    "setup:models": "tsx scripts/setupModels.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@sentry/electron": "^7.20.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "openai": "^7.23.0",
    "react-router": "^8.3.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@meeting-stt/core": "workspace:*",
    "@meeting-stt/design": "workspace:*",
    "@meeting-stt/models": "workspace:*",
    "@meeting-stt/telemetry": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.11.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsx": "^4.23.12",
    "vite": "^7.2.6"
  }
}
