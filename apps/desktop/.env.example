# 사용 정보 수집 설정 (test/usage-analytics 브랜치 전용, .claude/skills/meeting-stt-dev/references/telemetry.md "빌드 주입 값")
# 이 파일을 .env.local로 복사해 값을 채운다. .env.local은 커밋하지 않는다.
# 값이 빠진 싱크는 조용히 꺼진다.

# 자체 수집 서버 (apps/collector). 둘 다 있어야 켜진다
MAIN_VITE_COLLECTOR_URL=
MAIN_VITE_COLLECTOR_TEAM_TOKEN=

# PostHog (사용 이벤트·성능·환경). 호스트를 비우면 https://us.i.posthog.com
MAIN_VITE_POSTHOG_KEY=
MAIN_VITE_POSTHOG_HOST=

# Sentry (오류·크래시)
MAIN_VITE_SENTRY_DSN=
