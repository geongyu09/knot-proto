{
  "name": "@meeting-stt/collector",
  "version": "0.0.0",
  "private": true,
  "description": "사용 정보·회의 내용 수집 서버 (test/usage-analytics 브랜치 전용, Hono + node:sqlite)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/index.ts",
    "start": "tsx --no-warnings=ExperimentalWarning src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js",
    "dev:stack": "tsx scripts/devStack.ts",
    "inspect": "tsx --no-warnings=ExperimentalWarning scripts/inspect.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@meeting-stt/design": "workspace:*",
    "@meeting-stt/telemetry": "workspace:*",
    "hono": "^4.10.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12"
  }
}
